              "resize": {
                "maxWidth": 1280,
                "maxHeight": 1280,
                "maxBytes": 1048576
              }
            }
          },
          "samplingParams": {
            "temperature": 1.0,
            "top_p": 0.95,
            "top_k": 64
          },
          "cost": {
            "input": 0,
