{
  "$schema": "https://pi.dev/schemas/models.schema.json",
  "providers": {
    "splash-teacher": {
      "baseUrl": "https://openrouter.ai/api/v1",
      "api": "openai-completions",
      "apiKey": "$OPENROUTER_API_KEY",
      "models": [
        {
          "id": "google/gemma-4-31b-it",
          "name": "Gemma 4 31B (OpenRouter, teacher)",
          "input": [
            "text",
            "image"
          ],
          "reasoning": true,
          "contextWindow": 98304,
          "maxTokens": 8192,
