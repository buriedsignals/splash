{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "bun-types"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "brain",
    "core",
    "loop",
    "host",
    "delivery",
    "newsroom",
    "source"
  ],
  "exclude": []
}
