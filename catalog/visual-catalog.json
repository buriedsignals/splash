{
  "$schema": "./visual-catalog.schema.json",
  "schemaVersion": 1,
  "catalogId": "splash.visual-catalog",
  "mediums": [
    {
      "id": "chart",
      "label": "Chart",
      "description": "Values encoded as position, length, area, colour, or connection."
    },
    {
      "id": "map",
      "label": "Map",
      "description": "A spatial claim in which location or geographic shape is part of the evidence."
    },
    {
      "id": "image",
      "label": "Photograph",
      "description": "Journalist-supplied photographs with explicit alt text, credit, and rights."
    }
  ],
  "formats": [
    {
      "id": "static",
      "label": "Static image",
      "description": "A fixed visual designed to be read at rest."
    },
    {
      "id": "web",
      "label": "Interactive web",
      "description": "A self-contained page a reader can interrogate with pointer, touch, or keyboard."
    },
    {
      "id": "video",
      "label": "Video",
      "description": "A short fixed-duration motion build with one controlled reveal."
    },
    {
      "id": "scrolly",
      "label": "Scroll-driven story",
      "description": "A fixed visual that changes through explicit prose-led scroll steps."
    }
  ],
  "capabilities": [
    {
      "id": "map",
      "label": "Map production",
      "requiredCredentials": ["MAPTILER_KEY"],
      "requiredSettings": [],
      "repairAction": "open-readiness",
      "unavailableReason": "Map production needs a verified MapTiler key."
    },
    {
      "id": "map-delivery",
      "label": "Restricted live-map delivery",
      "requiredCredentials": ["MAPTILER_DELIVERY_KEY"],
      "requiredSettings": [],
      "repairAction": "open-readiness",
      "unavailableReason": "A restricted MapTiler delivery key is needed to keep the live map layer in a published page; the baked fallback can still be delivered."
    },
    {
      "id": "datawrapper",
      "label": "Datawrapper production",
      "requiredCredentials": ["DATAWRAPPER_TOKEN"],
      "requiredSettings": [],
      "repairAction": "open-readiness",
      "unavailableReason": "The delegated Datawrapper producer needs a verified Datawrapper token."
    },
    {
      "id": "hosted-embed",
      "label": "Hosted embed delivery",
      "requiredCredentials": ["CLOUDFLARE_API_TOKEN"],
      "requiredSettings": ["cloudflare-account-id"],
      "repairAction": "open-readiness",
      "unavailableReason": "Hosted embed delivery needs a verified Cloudflare token and the confirmed newsroom account ID."
    }
  ],
  "deliveryForms": [
    { "id": "owned-file", "label": "The file itself", "requiredCapabilities": [] },
    { "id": "cms-insertion", "label": "CMS insertion", "requiredCapabilities": [] },
    { "id": "source-bundle", "label": "Runnable source", "requiredCapabilities": [] },
    { "id": "embed", "label": "Deploy and receive embed code", "requiredCapabilities": ["hosted-embed"] }
  ],
  "producers": [
    { "id": "chart-beat", "label": "Custom static chart", "skill": "chart-beat" },
    { "id": "chart-web", "label": "Custom interactive chart", "skill": "chart-web" },
    { "id": "chart-video", "label": "Custom chart video", "skill": "chart-video" },
    { "id": "map-beat", "label": "Custom static or video map", "skill": "map-beat" },
    { "id": "map-web", "label": "Custom interactive map", "skill": "map-web" },
    { "id": "image-beat", "label": "Custom photograph beat", "skill": "image-beat" },
    { "id": "scrolly", "label": "Custom scroll-driven story", "skill": "scrolly" },
    { "id": "dw-beat", "label": "Datawrapper", "skill": "dw-beat" }
  ],
  "delegatedProducers": [
    {
      "id": "datawrapper",
      "label": "Datawrapper",
      "producer": "dw-beat",
      "capability": "datawrapper",
      "medium": "chart",
      "formats": ["static", "web"]
    }
  ],
  "formatPairs": [
    {
      "id": "chart.static",
      "label": "Static chart",
      "medium": "chart",
      "format": "static",
      "producer": "chart-beat",
      "sizeRule": { "kind": "required", "options": ["landscape", "square", "portrait"] },
      "interaction": { "kind": "none", "promise": "A fixed chart that states its evidence without reader interaction." },
      "deliveryForms": ["owned-file", "cms-insertion", "source-bundle"],
      "requiredCapabilities": [],
      "optionalCapabilities": [],
      "runtimePrerequisites": ["bun", "production-dependencies"],
      "browserPrerequisites": []
    },
    {
      "id": "chart.web",
      "label": "Interactive chart",
      "medium": "chart",
      "format": "web",
      "producer": "chart-web",
      "sizeRule": { "kind": "none" },
      "interaction": { "kind": "explore", "promise": "Every reading can expose an exact value by hover, tap, or keyboard while the static argument remains readable without JavaScript." },
      "deliveryForms": ["owned-file", "source-bundle", "embed", "cms-insertion"],
      "requiredCapabilities": [],
      "optionalCapabilities": [],
      "runtimePrerequisites": ["bun", "production-dependencies"],
      "browserPrerequisites": ["engine-managed-chromium"]
    },
    {
      "id": "chart.video",
      "label": "Chart video",
      "medium": "chart",
      "format": "video",
      "producer": "chart-video",
      "sizeRule": { "kind": "required", "options": ["landscape", "square", "portrait"] },
      "interaction": { "kind": "motion", "promise": "A fixed-duration build reveals one argument in a controlled order and ends on a readable held frame." },
      "deliveryForms": ["owned-file", "cms-insertion", "source-bundle"],
      "requiredCapabilities": [],
      "optionalCapabilities": [],
      "runtimePrerequisites": ["bun", "production-dependencies"],
      "browserPrerequisites": ["engine-managed-chromium"]
    },
    {
      "id": "chart.scrolly",
      "label": "Scroll-driven chart",
      "medium": "chart",
      "format": "scrolly",
      "producer": "scrolly",
      "sizeRule": { "kind": "none" },
      "interaction": { "kind": "scroll", "promise": "An opaque prose card advances a fixed chart through explicit steps while the page scrolls." },
      "deliveryForms": ["owned-file", "source-bundle", "embed", "cms-insertion"],
      "requiredCapabilities": [],
      "optionalCapabilities": [],
      "runtimePrerequisites": ["bun", "production-dependencies"],
      "browserPrerequisites": ["engine-managed-chromium"]
    },
    {
      "id": "map.static",
      "label": "Static map",
      "medium": "map",
      "format": "static",
      "producer": "map-beat",
      "sizeRule": { "kind": "required", "options": ["landscape", "square", "portrait"] },
      "interaction": { "kind": "none", "promise": "A fixed map with one baked camera and a complete legend." },
      "deliveryForms": ["owned-file", "cms-insertion", "source-bundle"],
      "requiredCapabilities": ["map"],
      "optionalCapabilities": [],
      "runtimePrerequisites": ["bun", "production-dependencies"],
      "browserPrerequisites": ["engine-managed-chromium"]
    },
    {
      "id": "map.web",
      "label": "Interactive map",
      "medium": "map",
      "format": "web",
      "producer": "map-web",
      "sizeRule": { "kind": "none" },
      "interaction": { "kind": "explore", "promise": "A reader can move through the map, retrieve exact values by pointer or keyboard, and use a linear accessible table; a baked fallback remains without JavaScript." },
      "deliveryForms": ["owned-file", "source-bundle", "embed", "cms-insertion"],
      "requiredCapabilities": ["map"],
      "optionalCapabilities": ["map-delivery"],
      "runtimePrerequisites": ["bun", "production-dependencies"],
      "browserPrerequisites": ["engine-managed-chromium"]
    },
    {
      "id": "map.video",
      "label": "Map video",
      "medium": "map",
      "format": "video",
      "producer": "map-beat",
      "sizeRule": { "kind": "required", "options": ["landscape", "square", "portrait"] },
      "interaction": { "kind": "motion", "promise": "A fixed camera and geometry build one spatial argument in a controlled order and hold the complete map at the end." },
      "deliveryForms": ["owned-file", "cms-insertion", "source-bundle"],
      "requiredCapabilities": ["map"],
      "optionalCapabilities": [],
      "runtimePrerequisites": ["bun", "production-dependencies"],
      "browserPrerequisites": ["engine-managed-chromium"]
    },
    {
      "id": "map.scrolly",
      "label": "Scroll-driven map",
      "medium": "map",
      "format": "scrolly",
      "producer": "scrolly",
      "sizeRule": { "kind": "none" },
      "interaction": { "kind": "scroll", "promise": "Prose-led steps advance one fixed map while the live layer remains leashed to the subject and the baked fallback remains available." },
      "deliveryForms": ["owned-file", "source-bundle", "embed", "cms-insertion"],
      "requiredCapabilities": ["map"],
      "optionalCapabilities": ["map-delivery"],
      "runtimePrerequisites": ["bun", "production-dependencies"],
      "browserPrerequisites": ["engine-managed-chromium"]
    },
    {
      "id": "image.static",
      "label": "Static photograph beat",
      "medium": "image",
      "format": "static",
      "producer": "image-beat",
      "sizeRule": { "kind": "required", "options": ["landscape", "square", "portrait"] },
      "interaction": { "kind": "none", "promise": "A fixed, uncropped photograph sequence with journalist-supplied words, alt text, and credit." },
      "deliveryForms": ["owned-file", "cms-insertion", "source-bundle"],
      "requiredCapabilities": [],
      "optionalCapabilities": [],
      "runtimePrerequisites": ["bun", "production-dependencies"],
      "browserPrerequisites": []
    },
    {
      "id": "image.scrolly",
      "label": "Scroll-driven photograph story",
      "medium": "image",
      "format": "scrolly",
      "producer": "scrolly",
      "sizeRule": { "kind": "none" },
      "interaction": { "kind": "scroll", "promise": "Journalist-supplied photographs advance through explicit prose-led steps without automatic description or cropping." },
      "deliveryForms": ["owned-file", "source-bundle", "embed", "cms-insertion"],
      "requiredCapabilities": [],
      "optionalCapabilities": [],
      "runtimePrerequisites": ["bun", "production-dependencies"],
      "browserPrerequisites": ["engine-managed-chromium"]
    }
  ],
  "treatments": [
    { "id": "chart.area", "medium": "chart", "label": "Area (and stacked area)", "reference": "chart-beat/references/types/area.md", "dataShape": { "summary": "One or more numeric series along a shared ordered axis; stacked areas also require a meaningful additive total.", "requires": ["numeric-series", "ordered-axis"] }, "formats": ["static", "web", "video", "scrolly"], "state": "selectable" },
    { "id": "chart.bar-and-column", "medium": "chart", "label": "Bar and column", "reference": "chart-beat/references/types/bar-and-column.md", "dataShape": { "summary": "One numeric value per category measured from a shared baseline.", "requires": ["categorical", "numeric-value"] }, "formats": ["static", "web", "video", "scrolly"], "state": "selectable" },
    { "id": "chart.beeswarm", "medium": "chart", "label": "Beeswarm", "reference": "chart-beat/references/types/beeswarm.md", "dataShape": { "summary": "Raw observations with one numeric measure; optional groups must preserve every observation.", "requires": ["numeric-value", "raw-observations"] }, "formats": ["static", "web", "video", "scrolly"], "state": "selectable" },
    { "id": "chart.boxplot", "medium": "chart", "label": "Box plot", "reference": "chart-beat/references/types/boxplot.md", "dataShape": { "summary": "A distribution, or a valid five-number summary, for each category.", "requires": ["categorical", "distribution"] }, "formats": ["static", "web", "video", "scrolly"], "state": "selectable" },
    { "id": "chart.bullet", "medium": "chart", "label": "Bullet", "reference": "chart-beat/references/types/bullet.md", "dataShape": { "summary": "An actual value and a comparable target for each measure, with optional ordered performance ranges.", "requires": ["actual-and-target", "numeric-value"] }, "formats": ["static", "web", "video", "scrolly"], "state": "selectable" },
    { "id": "chart.bump", "medium": "chart", "label": "Bump (ranking-over-time)", "reference": "chart-beat/references/types/bump.md", "dataShape": { "summary": "Ranks for multiple named entities at each point on an ordered axis.", "requires": ["multiple-series", "ordered-axis", "rank"] }, "formats": ["static", "web", "video", "scrolly"], "state": "selectable" },
    { "id": "chart.calendar-heatmap", "medium": "chart", "label": "Calendar heatmap", "reference": "chart-beat/references/types/calendar-heatmap.md", "dataShape": { "summary": "A real date and numeric value for each observed day.", "requires": ["calendar-date", "numeric-value"] }, "formats": ["static", "web", "video", "scrolly"], "state": "selectable" },
    { "id": "chart.connected-scatter", "medium": "chart", "label": "Connected scatter", "reference": "chart-beat/references/types/connected-scatter.md", "dataShape": { "summary": "Two numeric measures and an explicit order for every observation in one path.", "requires": ["numeric-pair", "ordered-axis"] }, "formats": ["static", "web", "video", "scrolly"], "state": "selectable" },
    { "id": "chart.diverging-bar", "medium": "chart", "label": "Diverging bar", "reference": "chart-beat/references/types/diverging-bar.md", "dataShape": { "summary": "One signed numeric value per category around a meaningful zero.", "requires": ["categorical", "signed-value"] }, "formats": ["static", "web", "video", "scrolly"], "state": "selectable" },
    { "id": "chart.diverging-stacked-bar", "medium": "chart", "label": "Diverging stacked bar (Likert)", "reference": "chart-beat/references/types/diverging-stacked-bar.md", "dataShape": { "summary": "Ordered response shares for each item, including an explicit neutral category where one exists.", "requires": ["categorical", "ordered-responses", "part-to-whole"] }, "formats": ["static", "web", "video", "scrolly"], "state": "selectable" },
    { "id": "chart.dot-strip", "medium": "chart", "label": "Dot strip", "reference": "chart-beat/references/types/dot-strip.md", "dataShape": { "summary": "Raw numeric observations grouped into named categories.", "requires": ["categorical", "numeric-value", "raw-observations"] }, "formats": ["static", "web", "video", "scrolly"], "state": "selectable" },
    { "id": "chart.dumbbell", "medium": "chart", "label": "Dumbbell (range plot)", "reference": "chart-beat/references/types/dumbbell.md", "dataShape": { "summary": "Exactly two comparable numeric values for each category.", "requires": ["categorical", "numeric-pair"] }, "formats": ["static", "web", "video", "scrolly"], "state": "selectable" },
    { "id": "chart.gantt", "medium": "chart", "label": "Gantt", "reference": "chart-beat/references/types/gantt.md", "dataShape": { "summary": "A named item with a valid start and end on one shared time scale.", "requires": ["interval", "temporal"] }, "formats": ["static", "web", "video", "scrolly"], "state": "selectable" },
    { "id": "chart.grouped-bar", "medium": "chart", "label": "Grouped bar", "reference": "chart-beat/references/types/grouped-bar.md", "dataShape": { "summary": "A small fixed set of comparable numeric series repeated across categories.", "requires": ["categorical", "multiple-series", "numeric-value"] }, "formats": ["static", "web", "video", "scrolly"], "state": "selectable" },
    { "id": "chart.heatmap", "medium": "chart", "label": "Heatmap (matrix)", "reference": "chart-beat/references/types/heatmap.md", "dataShape": { "summary": "Two categorical or temporal dimensions and one numeric value per cell.", "requires": ["matrix", "numeric-value"] }, "formats": ["static", "web", "video", "scrolly"], "state": "selectable" },
    { "id": "chart.histogram", "medium": "chart", "label": "Histogram", "reference": "chart-beat/references/types/histogram.md", "dataShape": { "summary": "Raw observations of one continuous numeric variable, or explicitly defined contiguous bins.", "requires": ["continuous-value", "distribution"] }, "formats": ["static", "web", "video", "scrolly"], "state": "selectable" },
    { "id": "chart.line", "medium": "chart", "label": "Line", "reference": "chart-beat/references/types/line.md", "dataShape": { "summary": "One or more numeric series on a shared ordered axis, usually time.", "requires": ["numeric-series", "ordered-axis"] }, "formats": ["static", "web", "video", "scrolly"], "state": "selectable" },
    { "id": "chart.lollipop", "medium": "chart", "label": "Lollipop", "reference": "chart-beat/references/types/lollipop.md", "dataShape": { "summary": "One non-negative numeric magnitude per category from a meaningful zero baseline.", "requires": ["categorical", "nonnegative-value"] }, "formats": ["static", "web", "video", "scrolly"], "state": "selectable" },
    { "id": "chart.marimekko", "medium": "chart", "label": "Marimekko (mosaic plot)", "reference": "chart-beat/references/types/marimekko.md", "dataShape": { "summary": "Group shares of a grand total plus each group's internal part-to-whole composition.", "requires": ["hierarchical", "part-to-whole"] }, "formats": ["static", "web", "video", "scrolly"], "state": "selectable" },
    { "id": "chart.parallel-coordinates", "medium": "chart", "label": "Parallel coordinates", "reference": "chart-beat/references/types/parallel-coordinates.md", "dataShape": { "summary": "Several numeric variables measured for every item, with an explicit scale for each axis.", "requires": ["multivariate", "numeric-value", "raw-observations"] }, "formats": ["static", "web", "video", "scrolly"], "state": "selectable" },
    { "id": "chart.pictogram", "medium": "chart", "label": "Pictogram (isotype)", "reference": "chart-beat/references/types/pictogram.md", "dataShape": { "summary": "A non-negative count and an explicit units-per-icon conversion that does not encode value by icon size.", "requires": ["count", "unit-conversion"] }, "formats": ["static", "web", "video", "scrolly"], "state": "selectable" },
    { "id": "chart.pie-and-donut", "medium": "chart", "label": "Pie and donut", "reference": "chart-beat/references/types/pie-and-donut.md", "dataShape": { "summary": "A small number of non-negative parts that exhaust one fixed whole.", "requires": ["few-categories", "part-to-whole"] }, "formats": ["static", "web", "video", "scrolly"], "state": "selectable" },
    { "id": "chart.population-pyramid", "medium": "chart", "label": "Population pyramid", "reference": "chart-beat/references/types/population-pyramid.md", "dataShape": { "summary": "Exactly two comparable groups measured across the same ordered bands.", "requires": ["numeric-pair", "ordered-categories"] }, "formats": ["static", "web", "video", "scrolly"], "state": "selectable" },
    { "id": "chart.radar", "medium": "chart", "label": "Radar (spider)", "reference": "chart-beat/references/types/radar.md", "dataShape": { "summary": "The same numeric variables and compatible radial scales for a small number of items.", "requires": ["few-series", "multivariate", "numeric-value"] }, "formats": ["static", "web", "video", "scrolly"], "state": "selectable" },
    { "id": "chart.sankey", "medium": "chart", "label": "Sankey", "reference": "chart-beat/references/types/sankey.md", "dataShape": { "summary": "Directed flows between ordered stages with non-negative magnitudes and conserved meaning.", "requires": ["directed-flow", "nonnegative-value", "staged-network"] }, "formats": ["static", "web", "video", "scrolly"], "state": "selectable" },
    { "id": "chart.scatter", "medium": "chart", "label": "Scatter (and bubble)", "reference": "chart-beat/references/types/scatter.md", "dataShape": { "summary": "Two continuous numeric measures for every observation; a bubble variant needs a third positive size measure.", "requires": ["numeric-pair", "raw-observations"] }, "formats": ["static", "web", "video", "scrolly"], "state": "selectable" },
    { "id": "chart.slope", "medium": "chart", "label": "Slope (slopegraph)", "reference": "chart-beat/references/types/slope.md", "dataShape": { "summary": "Exactly two comparable moments for each named category.", "requires": ["categorical", "numeric-pair", "two-moments"] }, "formats": ["static", "web", "video", "scrolly"], "state": "selectable" },
    { "id": "chart.small-multiples", "medium": "chart", "label": "Small multiples", "reference": "chart-beat/references/types/small-multiples.md", "dataShape": { "summary": "A repeatable chart schema across facets that can share scales or explicitly disclose scale differences.", "requires": ["facets", "repeatable-schema"] }, "formats": ["static", "web", "video", "scrolly"], "state": "selectable" },
    { "id": "chart.stacked-bar", "medium": "chart", "label": "Stacked bar", "reference": "chart-beat/references/types/stacked-bar.md", "dataShape": { "summary": "Additive numeric series within each category, where both the total and composition are meaningful.", "requires": ["categorical", "multiple-series", "part-to-whole"] }, "formats": ["static", "web", "video", "scrolly"], "state": "selectable" },
    { "id": "chart.streamgraph", "medium": "chart", "label": "Streamgraph", "reference": "chart-beat/references/types/streamgraph.md", "dataShape": { "summary": "Several non-negative series over an ordered axis where overall rhythm matters more than exact lookup.", "requires": ["multiple-series", "nonnegative-value", "ordered-axis"] }, "formats": ["static", "web", "video", "scrolly"], "state": "selectable" },
    { "id": "chart.treemap", "medium": "chart", "label": "Treemap", "reference": "chart-beat/references/types/treemap.md", "dataShape": { "summary": "Non-negative parts nested in meaningful groups, with values that sum within the hierarchy.", "requires": ["hierarchical", "nonnegative-value", "part-to-whole"] }, "formats": ["static", "web", "video", "scrolly"], "state": "selectable" },
    { "id": "chart.waterfall", "medium": "chart", "label": "Waterfall (bridge)", "reference": "chart-beat/references/types/waterfall.md", "dataShape": { "summary": "A starting total, an ordered sequence of signed deltas, and an arithmetically consistent ending total.", "requires": ["ordered-axis", "signed-value", "starting-and-ending-total"] }, "formats": ["static", "web", "video", "scrolly"], "state": "selectable" },
    { "id": "map.cartogram", "medium": "map", "label": "Cartogram", "reference": "map-beat/references/types/cartogram.md", "dataShape": { "summary": "Region geometry, adjacency that matters to the story, and a non-negative value used to distort area.", "requires": ["geographic-regions", "nonnegative-value"] }, "formats": ["static", "web", "video", "scrolly"], "state": "selectable" },
    { "id": "map.choropleth", "medium": "map", "label": "Choropleth", "reference": "map-beat/references/types/choropleth.md", "dataShape": { "summary": "Joinable named-region geometry and a normalized rate, share, or intensity rather than a raw count.", "requires": ["geographic-regions", "normalized-value", "region-join"] }, "formats": ["static", "web", "video", "scrolly"], "state": "selectable" },
    { "id": "map.contour-isoline", "medium": "map", "label": "Contour / isoline", "reference": "map-beat/references/types/contour-isoline.md", "dataShape": { "summary": "Dense georeferenced samples of a genuinely continuous field, sufficient to justify interpolation.", "requires": ["continuous-field", "dense-spatial-samples"] }, "formats": ["static", "web", "video", "scrolly"], "state": "proof-only", "disabledReason": "The doctrine reference is retained, but Splash has no shipped contour/isoline implementation; choose a supported map treatment instead." },
    { "id": "map.dot-density", "medium": "map", "label": "Dot density", "reference": "map-beat/references/types/dot-density.md", "dataShape": { "summary": "Joinable region polygons and non-negative totals whose within-region dot positions are explicitly synthetic.", "requires": ["count", "geographic-regions", "region-join"] }, "formats": ["static", "web", "video", "scrolly"], "state": "selectable" },
    { "id": "map.flow-map", "medium": "map", "label": "Flow map (route)", "reference": "map-beat/references/types/flow-map.md", "dataShape": { "summary": "One ordered route geometry or waypoint sequence whose path and direction are part of the claim.", "requires": ["geographic-route", "ordered-axis"] }, "formats": ["static", "web", "video", "scrolly"], "state": "selectable" },
    { "id": "map.hex-grid", "medium": "map", "label": "Hex grid (spatial binning)", "reference": "map-beat/references/types/hex-grid.md", "dataShape": { "summary": "Enough raw georeferenced events to support spatial aggregation into a regular grid.", "requires": ["dense-spatial-events", "geographic-points"] }, "formats": ["static", "web", "video", "scrolly"], "state": "selectable" },
    { "id": "map.locator", "medium": "map", "label": "Locator", "reference": "map-beat/references/types/locator.md", "dataShape": { "summary": "Named point locations with valid coordinates and optional categories, but no value encoded by marker size.", "requires": ["geographic-points", "place-labels"] }, "formats": ["static", "web", "video", "scrolly"], "state": "selectable" },
    { "id": "map.proportional-symbol", "medium": "map", "label": "Proportional symbol (symbol / bubble map)", "reference": "map-beat/references/types/proportional-symbol.md", "dataShape": { "summary": "Named point locations with valid coordinates and a positive numeric magnitude at each place.", "requires": ["geographic-points", "positive-value"] }, "formats": ["static", "web", "video", "scrolly"], "state": "selectable" },
    { "id": "image.photograph-sequence", "medium": "image", "label": "Photograph sequence", "reference": "image-beat/references/image-discipline.md", "dataShape": { "summary": "Journalist-supplied image files in an explicit order, each with rights, alt text, caption, and credit supplied by the journalist.", "requires": ["alt-text", "image-files", "image-rights", "photo-credit"] }, "formats": ["static", "scrolly"], "state": "selectable" }
  ]
}
