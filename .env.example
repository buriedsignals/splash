# Splash — environment configuration
#
# Copy this file to `.env` in the installed Splash root, or use the local
# installer setup page. `.env` is gitignored; never commit real credentials.
# Missing optional credentials close only the capability they name.

# --- Maps ---
# Development/rendering key. Preflight probes this key before offering maps.
# Get one at https://cloud.maptiler.com/account/keys/
MAPTILER_KEY=

# Optional SECOND key for delivered interactive maps. Restrict it to the
# publication's domain; it is embedded in the delivered HTML and is not probed
# from the command line because an origin-restricted key requires that origin.
MAPTILER_DELIVERY_KEY=

# --- Delegated Datawrapper charts (optional) ---
# Create at https://app.datawrapper.de/account/api-tokens
DATAWRAPPER_TOKEN=

# --- Hosted embeds through Cloudflare Pages (optional) ---
# Account id from https://dash.cloudflare.com and a token with Pages:Edit.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- CMS insertion package (optional) ---
# Supported kinds: wepublish or livingdocs. These values are recorded but not
# probed; Splash currently produces a mutation package and does not send it.
CMS_KIND=
CMS_ENDPOINT=
CMS_TOKEN=
