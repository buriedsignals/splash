# Splash — environment configuration
# Copy to `.env` and fill in. `.env` is gitignored; never commit real keys.

# --- Interface language (optional) ---
# Overrides the saved interface language for ONE run, without rewriting it: the delivery
# proposal Splash prints is emitted in this language. BCP-47 tag, e.g. fr, de, it.
# The saved default lives in newsroom.json (English on a fresh install); the language your
# VISUALS are made in is a separate field, `lang:` in NEWSROOM-PROFILE.md.
SPLASH_UI_LANG=

# --- Maps (required for map / video-with-map formats) ---
# MapTiler API key. Get one at https://cloud.maptiler.com/account/keys/
VITE_MAPTILER_KEY=
# Same key, exposed to Remotion for video rendering.
REMOTION_MAPTILER_KEY=

# --- Charts (required for the Datawrapper export path) ---
# Datawrapper API token. Create at https://app.datawrapper.de/account/api-tokens
DATAWRAPPER_API_TOKEN=

# --- Embed host (EXPORT → "lien embed" path, optional) ---
# The journalist's OWN fly.io app name (app names are globally unique — pick your own,
# e.g. <newsroom>-embeds). Can also be passed as the 3rd CLI arg to deploy-embed.mjs.
SPLASH_EMBED_APP=
# fly.io auth for headless/automated deploys. Create with: flyctl tokens create deploy
# Leave empty if you authenticate interactively with `flyctl auth login` instead.
FLY_API_TOKEN=
