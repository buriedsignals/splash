# Splash — legacy environment migration reference
#
# New installations use Engine's operating-system credential broker. Splash
# Readiness reports the exact credential IDs and their status but never reads or
# accepts values. Indicator Labs users save them in the desktop app; open-source
# users configure them through Engine's protected bsig stdin/keychain flow outside
# Splash. Retain a legacy .env only long enough to move its values and remove them
# by hand. Never commit real credentials.

# --- Maps ---
# Development/rendering key. Preflight probes this key before offering maps.
# Get one at https://cloud.maptiler.com/account/keys/
MAPTILER_KEY=

# Optional SECOND key for delivered interactive maps. Restrict it to the
# publication's domain; it is embedded in the delivered HTML and is not probed
# from the command line because an origin-restricted key requires that origin.
MAPTILER_DELIVERY_KEY=

# --- Delegated Datawrapper charts (optional) ---
# Create at https://app.datawrapper.de/account/api-tokens
DATAWRAPPER_TOKEN=

# --- Hosted embeds through Cloudflare Pages (optional) ---
# Account id from https://dash.cloudflare.com and a token with Pages:Edit.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- CMS insertion package (optional) ---
# Legacy copied roots may contain these names. Managed setup can migrate the
# non-secret kind/endpoint into newsroom configuration, but Engine does not
# register or migrate CMS_TOKEN because Splash has no live CMS operation.
# Splash currently produces a mutation package and does not send it.
CMS_KIND=
CMS_ENDPOINT=
CMS_TOKEN=
