const ASKED = {
  west: plateFacts.bounds[0][0],
  south: plateFacts.bounds[0][1],
  east: plateFacts.bounds[1][0],
  north: plateFacts.bounds[1][1],
};
// SCAFFOLD · REFUSE A WINDOW THAT CUTS THE STUDY SET, in this subject's own words: name the units
// the window slices, against the declared window, and say why a sliced unit under this title is a
// picture disagreeing with its own sentence. Measure `studySet` against ASKED, never against FRAME.

// ── SCAFFOLD · WHAT WEB MERCATOR COSTS **THIS** SUBJECT ───────────────────────────────────────
//
// The live map is flat Web Mercator (the owner, 2026-09-15: « oui une carte MapLibre plate pas un
// globe »), so the inflation of the north is a COST this page carries, not a defect to fix — and a
// cost a page carries is a cost it states. Derive it here and never type it: the drawn area is the
