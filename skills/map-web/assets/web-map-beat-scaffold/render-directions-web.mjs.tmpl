// ── SCAFFOLD · THE DATA, READ FROM THIS BEAT'S OWN FROZEN FILE ────────────────────────────────
//
// Read `%%DATA_FILE%%` here, derive every number the page prints, and BUILD THE STUDY SET:
//   const studySet = new Map();   // key → { west, south, east, north }, each unit's largest part
//   const CONTINENTAL = [];       // the one unit the frame deliberately does not hold whole
//   const STUDY = { west, south, east, north };  // the union of the held boxes
// The browser must never compute a break, apportion a dot, or format a number: everything the page
