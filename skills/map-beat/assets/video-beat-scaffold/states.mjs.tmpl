// THE CHOREOGRAPHY OF BRIEF.md, AS NUMBERS — one state per event (the picture at the event's end), run through
// `assertEventStates`: every event but the final hold changes the picture, and the hold changes nothing.
//
// SCAFFOLD: `title`, `furniture` and `source` are the fields every directed video shares. `reveal` and `subject` are
// stand-ins so the skeleton is a legal choreography — replace each with the gesture fields BRIEF.md's table names,
// set where their event lands, and document every field here:
//
//   title      the title card                                         0..1
//   furniture  what `reference` lays down (ticks, axis, the map's key) 0..1
//   reveal     SCAFFOLD — stand-in for the reveal's gesture(s)          0..1
//   subject    SCAFFOLD — stand-in for the subject's gesture(s)         0..1
//   source     the credit                                              0..1

import { EVENT_ORDER } from "#shared/chart-video/timing.ts";
const { skillScriptFrom } = await import("#shared/design-base/skill-script.mjs");
const { assertEventStates } = await import(skillScriptFrom(import.meta.dirname, "%%SKILL%%", "scripts", "choreography.mjs"));


export function statesFor() {
  const blank = { title: 0, furniture: 0, reveal: 0, subject: 0, source: 0 };
  const establish = { ...blank, title: 1 };
  const reference = { ...establish, title: 0, furniture: 1 };
  const reveal = { ...reference, reveal: 1 }; // SCAFFOLD: the reveal's gestures
  const subject = { ...reveal, subject: 1 }; // SCAFFOLD: the subject's gestures
  const conclusion = { ...subject, source: 1 }; // SCAFFOLD: what the close gives back
  const byEvent = { establish, reference, reveal, subject, conclusion, hold: { ...conclusion } };
  return assertEventStates(EVENT_ORDER.map((name) => byEvent[name]), [...EVENT_ORDER]);
}
