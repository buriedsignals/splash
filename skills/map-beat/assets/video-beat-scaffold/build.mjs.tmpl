// EVERYTHING ONE DIRECTION'S RENDER IS HANDED, BUILT IN BUN — the direction, its registers at the video's size, the
// live map's plan and cameras, the title card, the credit seated on the measured open sea, the colours floored, the
// states and the timing; and, in THE LAYOUT section, this beat's own overlay, placed on the map `measure.mjs`
// measured. The runner renders what `buildDirection` returns; the tests read the same object. A plan changed since
// its measurement is refused.
//
// THE DIRECTION IS COMPOSED FROM THE EDITORIAL SIDE, NOT PICKED FROM THE DEMO SET. `directionsFor` reads the
// newsroom's identity (the root's NEWSROOM.md), composes candidates with the design base (`composeDirections`) and
// returns the best one — exactly one. `candidates: N` returns the top N for the journalist to choose between;
// `filed: true` returns every filed direction, for a catalogue or demo proof only.
//
// Runs in Bun only.

import { existsSync, readdirSync, readFileSync } from "node:fs";
import { join } from "node:path";
import { adjustToContrast, mix, NON_TEXT_CONTRAST_MIN, TEXT_CONTRAST_MIN } from "#shared/chart-beat/colour.mjs";
import { deriveFurniture } from "#shared/chart-beat/render-still.mjs";
import { frameInsetFor, sizeFor } from "#shared/chart-video/sizes.mjs";
import { composeDirections, report as reportComposition } from "#shared/design-base/compose.mjs";
import { readDirection } from "#shared/design-base/read-direction.mjs";
import { directionReachable, readRunDirection } from "#shared/design-base/run-direction.mjs";
import { EYEBROW_TO_DISPLAY, registerOf } from "#shared/design-base/register.mjs";
import { resolveDirectionFamilies } from "#shared/design-base/resolve-families.mjs";
import { mapLabelFamily } from "#shared/map-beat/glyphs.mjs";





import { camerasOf, mapPlanFor, SEATS, STAGE } from "./map-plan.mjs";
import { planDigestOf } from "./measure.mjs";
import { statesFor } from "./states.mjs";
import { assertClaim, loadSubject } from "./subject.mjs";
import { %%CONST%%_VIDEO_TIMING } from "./timing-contract.ts";
const { skillScriptFrom } = await import("#shared/design-base/skill-script.mjs");
const { isDeclinedProfile, parseNewsroom, validateNewsroom } = await import(skillScriptFrom(import.meta.dirname, "splash", "scripts", "newsroom.mjs"));
const { applyCase } = await import(skillScriptFrom(import.meta.dirname, "map-beat", "scripts", "registers.mjs"));
const { CREDIT_ONE_LINE, haloOf, pillOf, sourceCreditFor, titleCardFor, verticalInsetFor, widthOf } = await import(skillScriptFrom(import.meta.dirname, "map-beat", "scripts", "shots.mjs"));
const { videoRegistersOf } = await import(skillScriptFrom(import.meta.dirname, "map-beat", "scripts", "video-registers.mjs"));
const { cellAt, offSeat, seatOnSea, touches } = await import(skillScriptFrom(import.meta.dirname, "map-beat", "scripts", "video-placement.mjs"));

const HERE = import.meta.dir;
export const ROOT = join(HERE, "%%UP%%");
/** THE FILED DEMO DIRECTIONS, WHEREVER THIS BEAT IS RUN FROM. They used to be read at
 *  `<root>/docs/design-base/directions`, which exists in a checkout and in no installed stories
 *  root — a root vendors `shared/`, and the three are vendored with it. `#shared/design-base`
 *  resolves them relative to itself, so the answer no longer depends on the beat's depth or on
 *  which kind of root it sits in. Measured 2026-09-23: a story that had a perfectly good
 *  DIRECTION.md still died on a directory it was never going to read. */
const { DIRECTIONS_DIR: DIRECTIONS } = await import("#shared/design-base/index.mjs");
export const SIZE = "%%SIZE%%";
export const REGISTER_NAMES = ["display", "eyebrow", "body", "annot", "value", "axis"];
/** The registers the overlay draws in — the six resolved ones, the map's `area` and `feature`, and the credit's. */
export const DRAWN_REGISTERS = ["display", "eyebrow", "value", "axis", "annot", "area", "feature", "source"];
/** The no-break space, written as its escape. */
export const NB = "\u00A0";
/** SCAFFOLD: how many ranked levels of evidence BRIEF.md names — the composer wants that many distinguishable voices. */
export const BEAT_FACTS = Object.freeze({ evidenceLevels: 3 });
/** The mark every scaffold placeholder in the copy carries; `assertWritten` refuses a render while one is left. */
export const SCAFFOLD_MARK = "SCAFFOLD";
/** Air between a word and anything else, × the axis lead; how far the credit's search steps, in pixels. */
const GAP = 0.25;
const CREDIT_STEP = Object.freeze({ x: 20, y: 5 });

export function loadBeat() {
  const subject = loadSubject();
  return { subject, states: statesFor(), copy: copyOf(subject), mapSeats: { ...SEATS } };
}

/** The words. SCAFFOLD: write the copy — every string carrying SCAFFOLD_MARK is refused by the runner. */
export function copyOf(subject) {
  return {
    eyebrow: "SCAFFOLD eyebrow",
    /** The title's forms, longest first: the title card takes the first that holds its lines. */
    title: ["SCAFFOLD the title, its longest form", "SCAFFOLD the title"],
    /** The credit's forms, longest first, each with the basemap's attribution: the longest that finds open sea wins. */
    source: ["Source : SCAFFOLD · © MapTiler © OpenStreetMap", "SCAFFOLD · © MapTiler © OpenStreetMap"],
  };
}

/** What each register sets on this beat — the faces are resolved to cover it. SCAFFOLD: every word the overlay draws. */
export function textPerRegisterOf(copy) {
  return {
    display: copy.title.join(" "),
    eyebrow: copy.eyebrow,
    body: copy.source.join(" "),
    annot: "0123456789",
    value: "0123456789",
    axis: `0123456789 ${copy.source.join(" ")}`,
  };
}

/** Refuses a beat still carrying a scaffold placeholder: the copy, and the claim's assertions. */
export function assertWritten(beat) {
  if (JSON.stringify(beat.copy).includes(SCAFFOLD_MARK)) throw new Error(`the copy still carries ${SCAFFOLD_MARK} placeholders — write it (build.mjs, copyOf)`);
  assertClaim(beat.subject);
}

// ── the direction ─────────────────────────────────────────────────────────────────────────────────────────────

/** The newsroom's identity: its ground, its primary accent and its declared faces, or null when it has none on record — and why. */
export function newsroomOf(root = ROOT) {
  const path = join(root, "NEWSROOM.md");
  if (!existsSync(path)) return { newsroom: null, note: "no NEWSROOM.md at the root: composed without a newsroom palette" };
  const profile = parseNewsroom(readFileSync(path, "utf8"));
  if (isDeclinedProfile(profile)) return { newsroom: null, note: "the newsroom declined a house profile: composed without a newsroom palette" };
  const errors = validateNewsroom(profile);
  if (errors.length) throw new Error(`NEWSROOM.md is not a complete profile (${errors.join("; ")}) — complete it, or record a decline`);
  // `typefaces` travels with the palette: the composer gives a declared house face the registers it can serve and
  // names in its report every face it could not use, with the reason. Dropping the field here is what made the house
  // faces invisible — a newsroom filled the line in and nothing downstream ever read it.
  const typefaces = (profile.typefaces ?? "").split(",").map((face) => face.trim()).filter(Boolean);
  const faces = typefaces.length ? `, faces ${typefaces.join(", ")}` : "";
  return { newsroom: { ground: profile.ground, accent: profile.brandColor, typefaces }, note: `composed for ${profile.name}: ground ${profile.ground}, accent ${profile.brandColor}${faces} (NEWSROOM.md)` };
}

export const filedDirections = () =>
  readdirSync(DIRECTIONS)
    .filter((f) => f.endsWith(".md"))
    .sort()
    .map((f) => readDirection(join(DIRECTIONS, f)));

const labelOf = (id) => id.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");

/**
 * The direction(s) this beat renders in, each `{ label, direction }`.
 *   default           ONE — the composer's best candidate for the newsroom and this beat's own text
 *   { candidates: N } the composer's top N, for the journalist to choose between
 *   { filed: true }   every filed demo direction — a catalogue or demo proof, never a production render
 */
export function directionsFor(beat, { candidates = 1, filed = false, root = ROOT } = {}) {
  // READ ONLY WHERE THEY ARE USED. The production path below never touches the filed demo
  // directions — it reads the run's own DIRECTION.md — and reading them eagerly made a story die
  // on a directory it was never going to open.
  if (filed) return { directions: filedDirections().map((d) => ({ label: labelOf(d.id), direction: d })), composition: null, note: "every filed demo direction (--filed): a catalogue proof, not a production render" };
  if (!(Number.isInteger(candidates) && candidates >= 1)) throw new Error(`candidates is a count of at least 1, got ${JSON.stringify(candidates)}`);
  // THE RUN'S ONE ART DIRECTION COMES FIRST (ruling R-A). It was composed once for this story,
  // from NEWSROOM.md and the subject, and written at the story root beside PALETTE.md. Every export
  // of the run reads THAT file — the still, the video, this one, the scrolly — so two exports of
  // one claim can never land in two palettes or two type ladders.
  //
  // Re-composing here instead is how they drift: the composer is fed `textPerRegister`, and an
  // export's text is by definition not its siblings' text, so the same story composes a slightly
  // different ladder per export and the four agree only by luck. Measured 2026-09-23 on a real
  // story: the video re-composed and happened to match the still, which is exactly what makes this
  // invisible until the day it does not.
  //
  // A beat with NO reachable DIRECTION.md is the catalogue, which composes its own — and `--filed`
  // stays the catalogue's escape to the three demo directions.
  if (candidates === 1 && directionReachable(HERE)) {
    const run = readRunDirection(HERE);
    return {
      directions: [{ label: labelOf(run.id), direction: run }],
      composition: null,
      note: `the run's one art direction, read from ${run.source}`,
    };
  }
  const { newsroom, note } = newsroomOf(root);
  const composition = composeDirections({ newsroom, filed: filedDirections(), beat: BEAT_FACTS, textPerRegister: textPerRegisterOf(beat.copy), limit: Math.max(3, candidates) });
  if (!composition.offered.length) throw new Error(`no composed direction holds up for this beat:\n${reportComposition(composition, { beat: BEAT_FACTS })}`);
  const directions = composition.offered.slice(0, candidates).map((d) => ({ label: labelOf(d.id), direction: d }));
  return { directions, composition, note };
}

/** The runner's direction flags: `--candidates <N>` and `--filed` are opt-in, and exclusive; `--only <label>`. */
export function parseDirectionArgs(args) {
  const valueOf = (name) => {
    const i = args.indexOf(name);
    if (i === -1) return null;
    if (!args[i + 1] || args[i + 1].startsWith("--")) throw new Error(`${name} takes a value`);
    return args[i + 1];
  };
  const raw = valueOf("--candidates");
  if (raw !== null && !/^[1-9]\d*$/.test(raw)) throw new Error(`--candidates takes a count of at least 1, got ${JSON.stringify(raw)}`);
  const filed = args.includes("--filed");
  if (filed && raw !== null) throw new Error("--filed and --candidates are exclusive: --filed renders the demo directions, --candidates the composed ones");
  return { candidates: raw === null ? 1 : Number(raw), filed, only: valueOf("--only"), still: args.includes("--still"), look: valueOf("--look") };
}

// ── the measurement ───────────────────────────────────────────────────────────────────────────────────────────

export const MEASURED = join(HERE, "measured.json");
export function readMeasured() {
  if (!existsSync(MEASURED)) throw new Error("no measured.json beside the beat — run measure.mjs with the worktree's .env loaded");
  return JSON.parse(readFileSync(MEASURED, "utf8"));
}

/** The map's words at the video's size: `area` the axis tracked to at least 0.8 px of the still (× k), `feature` at 700. */
export function mapRegistersOf({ axis }, k) {
  const area = { ...axis, letterSpacing: Math.max(Number(axis.letterSpacing ?? 0), 0.8 * k) };
  return { area, feature: { ...area, fontWeight: 700 } };
}

// ── the build ─────────────────────────────────────────────────────────────────────────────────────────────────

/**
 * @param {{ label: string, direction: object }} entry  one of `directionsFor(beat).directions`
 * @param {{ measured?: any }} [options]  `measured: null` builds the plan and cameras only — what `measure.mjs` reads
 */
export function buildDirection({ label, direction: chosen }, { subject, states, copy }, { measured } = {}) {
  const direction = resolveDirectionFamilies(chosen, textPerRegisterOf(copy));
  const cameras = camerasOf();
  const mapPlan = mapPlanFor({ direction, subject, cameras });
  if (measured === null) return { label, direction, props: { mapPlan, cameras } };
  const measurement = measured ?? readMeasured();
  if (!measurement.cameras?.[label]) throw new Error(`${label}: not measured — run measure.mjs with the worktree's .env loaded`);
  if (measurement.planDigest?.[label] !== planDigestOf(mapPlan)) throw new Error(`${label}: the plan changed since it was measured — run measure.mjs again`);
  const m = measurement.cameras[label];

  const resolved = Object.fromEntries(REGISTER_NAMES.map((name) => [name, registerOf(direction, name)]));
  const scaled = videoRegistersOf(resolved, SIZE);
  const k = scaled.axis.fontSize / resolved.axis.fontSize;
  const registers = { ...scaled, ...mapRegistersOf(scaled, k) };
  // THE MAP'S OWN LABELS, WHEN THE HOUSE FACE IS NOT ONE MAPTILER SERVES (the owner's ruling, 2026-09-16):
  // the face keeps every word outside the map; only these stand in, on the register's own role ladder,
  // and the swap is said out loud rather than discovered by comparing the panel to the map.
  const roleOf = (name) => direction.decisions?.find((d) => d.register === name)?.role ?? "sans";
  for (const [name, r] of Object.entries(registers)) {
    const { family, stoodInFor } = mapLabelFamily(r.fontFamily, { role: roleOf(name) });
    if (!stoodInFor) continue;
    registers[name] = { ...r, mapFamily: family };
    console.log(`${label}: the map's labels in the ${name} register are set in ${family} — MapTiler does not serve ${stoodInFor}`);
  }
  const row = sizeFor(SIZE);
  for (const [name, r] of Object.entries(registers)) if (!(r.fontSize >= row.minTypePx)) throw new Error(`${label}: register ${name} is ${r.fontSize}px, under the ${row.minTypePx}px floor`);
  const frame = { width: row.width, height: row.height };
  /** THE MEASUREMENT AND THE FRAME ARE THE SAME PIXELS, OR NOTHING BELOW MEANS ANYTHING.
   *
   *  Every seat, every projected point and the whole colour grid come out of a browser sized by
   *  `measure.mjs`; every word below is placed inside `frame`. When the two were different sizes the
   *  placement searched a grid that stopped half way up the frame, scored the empty space a perfect
   *  zero, and seated the credit on land — with the beat's own suite green, because no rule compared
   *  them. It is compared here, once, before a single word is placed. */
  if (measurement.size?.width !== frame.width || measurement.size?.height !== frame.height)
    throw new Error(
      `${label}: measured at ${measurement.size?.width}x${measurement.size?.height} but this beat ` +
        `draws at ${frame.width}x${frame.height} (--size ${SIZE}). Every seat and the colour grid ` +
        `are in the wrong pixel space — run measure.mjs again for this size.`,
    );
  const stage = { x: 0, y: 0, ...STAGE };
  const inset = frameInsetFor(SIZE);
  const vInset = verticalInsetFor(SIZE);
  const air = GAP * registers.axis.lead;
  /** A word as drawn: cased by its register, measured on the face the composition embeds. */
  const measure = (text, r) => {
    const cased = applyCase(text, r.transform);
    return { text: cased, width: widthOf(cased, r) };
  };

  // ── the shots every directed video shares: the title card from frame 0; the credit's one-line forms ──────────
  const titleCard = titleCardFor({ registers, eyebrow: copy.eyebrow, title: copy.title, size: SIZE, eyebrowToDisplay: EYEBROW_TO_DISPLAY });
  const sources = copy.source.flatMap((form) => {
    try {
      return [sourceCreditFor({ registers, forms: [form], size: SIZE, k, ...CREDIT_ONE_LINE })];
    } catch {
      return [];
    }
  });
  if (!sources.length) throw new Error(`${label}: no form of the source holds one line`);

  // ── colours: the sea is the plan's own water tint, what the dataviz style paints and the measure reads back ──
  const { ground, accent } = direction;
  const { ink, muted } = deriveFurniture(ground);
  const sea = mapPlan.tints.water;
  const walk = (colour, on, floor, what) => {
    const walked = adjustToContrast(colour, on, floor);
    if (!walked) throw new Error(`${label}: ${what} has no variant that reads at ${floor}:1 on ${on}`);
    return walked;
  };
  const colours = {
    ground,
    sea,
    land: mapPlan.tints.land,
    accent: walk(accent, ground, NON_TEXT_CONTRAST_MIN, "the accent"),
    text: {
      eyebrow: walk(registers.eyebrow.fill ?? accent, ground, TEXT_CONTRAST_MIN, "the eyebrow"),
      title: walk(registers.display.fill ?? ink, ground, TEXT_CONTRAST_MIN, "the title"),
      source: walk(muted, sea, TEXT_CONTRAST_MIN, "the credit"),
    },
    // SCAFFOLD: this beat's own colours, each walked to its floor on what it stands over.
  };
  const strokes = { border: (direction.stroke?.hairline ?? 0.6) * k, rule: (direction.stroke?.rule ?? 1) * k };

  // ── the credit: the longest one-line form that finds open sea on the whole map, anchored to the bottom ───────
  const seated = seatOnSea({
    grids: [m.whole.grid],
    sea,
    sizes: sources,
    within: { x: inset, y: vInset, width: frame.width - 2 * inset, height: frame.height - 2 * vInset },
    step: CREDIT_STEP,
  });
  /**
   * AND WHEN NO FORM FINDS OPEN SEA, THE CREDIT GETS A PILL — it is not a dead end.
   *
   * A square frame pairs the NARROWEST width (1080) with the HIGHEST type floor (36 px), and it
   * reserves no stage, so the whole frame is the budget: the bare basemap attribution alone needs
   * about half the frame's width in unbroken water. Measured 2026-09-23 on a whole-continent map at
   * square, with the stage already corrected: the widest all-sea run inside the credit band was
   * 576 px against a 564 px minimum form, and no box of it was three rows deep. The beat refused,
   * and the refusal offered the journalist no lever — shortening the copy cannot help, because the
   * floor is the mandatory attribution.
   *
   * So the shortest form is seated on a pill instead, against the frame's own bottom inset, and the
   * refusal becomes a line that says what was measured. Any whole-continent map video at square
   * takes this path; it is the ordinary outcome for that slot, not a failure of this beat.
   */
  let credit;
  let creditPill = null;
  if (seated) {
    credit = sources[seated.index];
  } else {
    credit = sources[sources.length - 1];
    creditPill = pillOf(credit.text, credit.register);
    console.log(
      `${label}: no one-line form of the source finds open sea on the whole map — the shortest ` +
        `(${Math.round(widthOf(credit.text, credit.register))}px) is seated on a pill at the frame's ` +
        `bottom instead. Widen FIT in map-plan.mjs to open more water if the pill is unwanted.`,
    );
  }
  registers.source = credit.register;

  // ════ THE LAYOUT — SCAFFOLD ═══════════════════════════════════════════════════════════════════════════════════
  // SCAFFOLD: this beat's overlay, placed on the measured map — the key or panel (`keyFor`, seated with `seatOnSea`
  // avoiding the credit's box), every name at its measured seat (`m.<camera>.projected[id]`, `pillOf`, kept clear of
  // each other with `touches` and led to its seat past `offSeat`), the colour under a word read with `cellAt`. Every
  // placement asserted: throw when a word leaves the stage or lands on a mark. Hand the frame everything it draws
  // through `layout`; the frame chooses nothing.
  const layout = {};
  // ════ END OF THE LAYOUT ═══════════════════════════════════════════════════════════════════════════════════════

  const props = {
    frame,
    stage,
    registers: Object.fromEntries(DRAWN_REGISTERS.map((name) => [name, registers[name]])),
    titleCard,
    credit: seated
      ? { ...credit, at: { x: seated.box.x, y: seated.box.y }, pill: null }
      : {
          ...credit,
          // No open sea anywhere on the map: the pill sits against the frame's own bottom inset,
          // centred, and carries its own ground so the words stay readable over land.
          at: {
            x: Math.round((frame.width - creditPill.width) / 2),
            y: frame.height - vInset - creditPill.height,
          },
          pill: creditPill,
        },
    colours,
    strokes,
    halo: haloOf(registers.value, k),
    cameras,
    mapPlan,
    ...layout,
    states,
    timing: %%CONST%%_VIDEO_TIMING,
  };
  return { label, direction, props, report: { k, titleForm: titleCard.form, titleSize: titleCard.register.fontSize, sourceText: credit.lines[0].text } };
}
