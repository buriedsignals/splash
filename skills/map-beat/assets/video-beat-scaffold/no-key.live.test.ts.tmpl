import { describe, expect, it } from "bun:test";
import { existsSync, readdirSync, readFileSync, statSync } from "node:fs";
import { join } from "node:path";
import { mapTilerKeyIn } from "#shared/map-beat/glyphs.mjs";
const { skillScriptFrom } = await import("#shared/design-base/skill-script.mjs");
const { DEFAULT_CACHE_DIR } = await import(skillScriptFrom(import.meta.dirname, "map-beat", "scripts", "maptiler-proxy.mjs"));


/** After a render: the MapTiler key is in no file the render or the measurement wrote. Needs the worktree's .env. */
const key = mapTilerKeyIn(process.env);
const renders = join(import.meta.dir, "renders");
const files = (dir: string): string[] => (existsSync(dir) ? readdirSync(dir).flatMap((f) => (statSync(join(dir, f)).isDirectory() ? files(join(dir, f)) : [join(dir, f)])) : []);

describe.skipIf(!existsSync(renders))("the outputs of %%BEAT%% (once rendered)", () => {
  it("should carry the MapTiler key in no render, props file, measurement or cached tile", () => {
    if (!key) throw new Error("no MapTiler key in the environment: run with the worktree's .env loaded");
    const written = [...files(renders), ...files(DEFAULT_CACHE_DIR), join(import.meta.dir, "measured.json")].filter((f) => existsSync(f));
    expect(written.length).toBeGreaterThan(3);
    expect(written.filter((f) => readFileSync(f).includes(Buffer.from(key)))).toEqual([]);
  });
});
