// `%%BEAT%%` AS A MAP PLAN — MapTiler's dataviz style, flat Web Mercator, mounted once and driven by numbers: a camera
// in Mercator fields and the plan's bound fields, both from `mapStateAt` (`scene.mjs`). The plan's MapTiler URLs
// carry a key PLACEHOLDER, never the key: the runner's local proxy strips it (`throughProxy`) and holds the key.
//
// SCAFFOLD: what the whole map holds (BOUNDS), the other cameras, the seats, and the layers are this beat's own.

import { sizeFor } from "#shared/chart-video/sizes.mjs";
import { viewOf } from "#shared/map-beat/scrolly.mjs";
import { plateTints } from "#shared/map-beat/tints.mjs";
const { skillScriptFrom } = await import("#shared/design-base/skill-script.mjs");
const { fitBoundsMeet } = await import(skillScriptFrom(import.meta.dirname, "map-beat", "scripts", "video-placement.mjs"));


/** THE STAGE THE CAMERA IS FITTED TO, AND IT IS THIS BEAT'S OWN SLOT — never a literal.
 *
 *  `fitBoundsMeet` takes `min(stage.width/dx, stage.height/dy)`, so a stage that is not the frame
 *  fits the geography to a frame nobody is going to watch. Measured 2026-09-23 with the literal in
 *  place: landscape agreed by coincidence (1920x1080 IS its slot) and square agreed by a second one
 *  (these bounds are height-bound, so `min()` picked 1080 either way) — and PORTRAIT drew the
 *  continent at 0.67x, filling 52% of the frame where `fit` promises 92%, with a slab of empty
 *  Atlantic above and Africa below. The beat's own suite was 20 pass / 0 fail throughout: nothing
 *  in the toolchain compared the stage to the slot, so the two literals that agree for two of the
 *  three sizes hid the one that does not. */
export const STAGE = Object.freeze(sizeFor("%%SIZE%%"));
const KEY = "__MAPTILER" + "_KEY__";
/** MapTiler Countries: one `administrative` layer, `level` 0 the countries and 1 their regions, joined on `iso_a2`. */
export const COUNTRIES = Object.freeze({ type: "vector", url: `https://api.maptiler.com/tiles/countries/tiles.json?key=${KEY}` });
export const COUNTRIES_LAYER = "administrative";
/** The fields the plan's bindings read (`{ $state: field }`) — `mapStateAt` returns every one. SCAFFOLD. */
export const MAP_FIELDS = Object.freeze([]);
/** What the whole map holds, [[west, south], [east, north]]. SCAFFOLD: the study set's own extent. */
export const BOUNDS = Object.freeze([[-170, -58], [180, 78]]);
/** The share of the stage the bounds are fitted into, "meet". */
const FIT = 0.92;
/** Where each word the overlay places is anchored, [lon, lat]; `measure.mjs` measures each at every camera. SCAFFOLD. */
export const SEATS = Object.freeze({});

export function camerasOf() {
  const whole = fitBoundsMeet({ bounds: BOUNDS, stage: STAGE, fit: FIT });
  // SCAFFOLD: every other camera the argument travels to — a close-up centres its subject on both axes.
  return { whole };
}

export function mapPlanFor({ direction, cameras }) {
  const tints = plateTints(direction);
  return {
    styleUrl: `https://api.maptiler.com/maps/dataviz/style.json?key=${KEY}`,
    styleName: "dataviz",
    projection: "mercator",
    tints: { water: tints.water, land: tints.land },
    referenceWidth: STAGE.width,
    referenceHeight: STAGE.height,
    degreesPerPixel: 1,
    camera: { view: viewOf(cameras.whole) },
    // ════ THE LAYERS — SCAFFOLD ════
    // SCAFFOLD: this beat's layers — `source: COUNTRIES`, `sourceLayer: COUNTRIES_LAYER`, `beneath: "water"`, a
    // `filter` on `level` and `iso_a2` — every paint from the direction, every moving paint bound to MAP_FIELDS
    // through `bindings`.
    layers: [],
  };
}
